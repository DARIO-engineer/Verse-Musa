{
  "cli": {
    "version": ">= 16.15.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "NODE_ENV": "production",
        "EXPO_NO_DOTENV": "1"
      },
      "cache": {
        "key": "preview-cache",
        "cacheDefaultPaths": true,
        "customPaths": ["node_modules"]
      }
    },
    "optimized": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "NODE_ENV": "production",
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "EXPO_OPTIMIZE_SIZE": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
